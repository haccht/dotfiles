[user]
  name = haccht
  email = haccht@users.noreply.github.com
[init]
  defaultBranch = main
[push]
  default = simple
[pull]
  ff = only
[fetch]
  prune = true
[rebase]
  autoStash = true
[rerere]
  enabled = true
[diff]
  algorithm = histogram
[merge]
  conflictStyle = zdiff3
[alias]
  graph = log --pretty=format:\"%C(yellow)%h %C(White)%ad | %C(White)%s%C(Green)%d %C(Red)[%an]\" --graph --date=short
[include]
  path = ~/.gitconfig_local
[color]
  ui = auto
  status = auto
  diff = auto
  branch = auto
  interactive = auto
  pager = true
  grep = true
[url "ssh://git@git.source.akamai.com:7999/"]
  insteadOf = https://git.source.akamai.com/
